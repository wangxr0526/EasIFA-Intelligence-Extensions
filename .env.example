EASIFA_AGENT_BASE_URL=https://cadd.drugflow.com/easifa
EASIFA_BACKEND_BASE_URL=https://cadd.drugflow.com/easifa
EASIFA_AGENT_BEARER_TOKEN=
EASIFA_AGENT_TIMEOUT_SECONDS=120
# Optional: reuse an existing owner key (43-128 URL-safe characters). Keep it secret.
# EASIFA_SESSION_KEY=
# Otherwise an identity is created and reused in $XDG_STATE_HOME/easifa-mcp/<profile>/session.json
# (default state directory: ~/.local/state). Override with a stable private path:
# EASIFA_MCP_SESSION_FILE=/absolute/private/path/easifa-session.json
